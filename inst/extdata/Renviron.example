# Copy this file to .Renviron (project-level) or ~/.Renviron (user-level) and
# fill in your values. alchemeR never accepts credentials as bare function
# arguments in a way that would end up committed to project source -- every
# setting below is read from the environment (or, for the API secret, may be
# supplied at runtime via keyring instead; see vignette("scheduling")).

# Required
ALCHEMER_API_TOKEN=
ALCHEMER_API_SECRET=

# Required for ingest()/pub_layer()/alchemer_db() and friends: the directory
# that will hold catalog.ducklake and data/. Use an absolute path for a
# scheduled job, since its working directory is not guaranteed.
ALCHEMER_DB=

# Timezone for the publication layer. pub_layer() presents every pub
# timestamp as wall-clock time in this zone, and reads Alchemer's unsuffixed
# timestamps (date_updated, created_on, modified_on) as already being in it --
# so it should match your Alchemer account's timezone setting. `raw` is never
# converted: it keeps whatever string the API sent.
#
# SET THIS EXPLICITLY for a scheduled job. Left unset it falls back to the
# machine's own timezone, which would make pub's values depend on which
# machine last ran pub_layer() (a laptop in Toronto and a server in UTC would
# write different numbers into the same shared database).
ALCHEMER_TZ=America/Toronto

# Optional -- defaults shown
# Regional API base domain. See https://apihelp.alchemer.com/help/api-base-domains
#   United States: api.alchemer.com (default)
#   European Union: api.alchemer.eu
#   Canada:         api.alchemer-ca.com
#   Australia:      api.au.alchemer.com
ALCHEMER_DOMAIN=api.alchemer.com

# Request-per-minute throttle ceiling. The documented account-wide limit is
# 240/min; the default here leaves headroom for interactive use of the same
# account while ingest() runs.
ALCHEMER_RPM=100

# Maximum days since a survey's last successful refresh before ingest()
# refreshes it regardless of change detection -- a correctness backstop, not
# a freshness setting. Lower it for accounts with edit-heavy closed surveys.
ALCHEMER_FULL_SWEEP_DAYS=90

# --- Analytics database (only needed for inst/scripts/etl_pipeline.R) -----
# load_pub_layer()/load_pipeline_health() are plain DBI and work against any
# DBI backend; these variables match the odbc + SQL Server example in
# etl_pipeline.R. The service account they name only ever needs
# CREATE TABLE / DROP TABLE / INSERT privileges on ANALYTICS_DB_SCHEMA --
# never SELECT -- since nothing reads the destination back to decide what
# to load (see vignette("scheduling")).
ANALYTICS_DB_DRIVER=ODBC Driver 18 for SQL Server
ANALYTICS_DB_SERVER=
ANALYTICS_DB_DATABASE=
ANALYTICS_DB_SCHEMA=dbo
ANALYTICS_DB_UID=
# Prefer keyring over a plaintext password here where possible; see
# vignette("scheduling").
ANALYTICS_DB_PWD=
